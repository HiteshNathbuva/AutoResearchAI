# --- LLM (required) ---------------------------------------------------------
OPENROUTER_API_KEY=replace_with_your_key
APP_NAME=AutoResearchAI
APP_VERSION=0.2.0
ENVIRONMENT=development
MODEL_NAME=deepseek/deepseek-chat-v3-0324:free
TEMPERATURE=0.7
MAX_TOKENS=4096
LOG_LEVEL=INFO
DATABASE_PATH=database/autoresearch.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Optional real web research (Phase 2) ------------------------------------
# All of the following are OPTIONAL. The application starts fine without them.
# Web research is DISABLED unless WEB_RESEARCH_ENABLED=true.
WEB_RESEARCH_ENABLED=false

# Search provider: auto | tavily | none. "auto" uses Tavily when TAVILY_API_KEY
# is set and falls back to the keyless/disabled provider otherwise.
SEARCH_PROVIDER=auto
# Optional Tavily API key. Never commit a real key. When absent and search is
# enabled, the system degrades gracefully to LLM-only research.
TAVILY_API_KEY=

# Bounded resource limits (safe defaults).
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=10
SEARCH_MAX_RETRIES=2
MAX_FETCHED_SOURCES=5
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_REDIRECTS=3
FETCH_MAX_BYTES=2000000
EXTRACT_MAX_CHARS=8000
