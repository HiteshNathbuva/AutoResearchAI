# Base URL for the backend API.
#
# Leave this commented out to use the relative path "/api", which the Vite dev
# server proxies to http://127.0.0.1:8000 (see vite.config.js) and which also
# works for same-origin production deployments where the API serves the SPA.
#
# Set an absolute URL only when the frontend is hosted on a different origin
# than the API. The backend must then allow this origin via CORS_ORIGINS.
#
# VITE_API_URL=/api
# VITE_API_URL=https://your-backend.example.com/api
